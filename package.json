{
  "name": "share-the-spire-uploader",
  "productName": "Share The Spire Uploader",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Electron desktop app that watches Slay the Spire 2 save files and uploads them to sharethespire.com.",
  "author": {
    "name": "KascadeKyle",
    "url": "https://github.com/KascadeKyle"
  },
  "homepage": "https://sharethespire.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/KascadeKyle/share-the-spire-uploader.git"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('release',{recursive:true,force:true});\"",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "41.5.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.sharethespire.uploader",
    "productName": "Share The Spire Uploader",
    "copyright": "Copyright © ${author}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "images/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/.env*",
      "!**/{.DS_Store,Thumbs.db}"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "images/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Share The Spire Uploader",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KascadeKyle",
        "repo": "share-the-spire-uploader",
        "releaseType": "draft"
      }
    ]
  }
}
