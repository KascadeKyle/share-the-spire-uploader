# Copy this file to `.env` to override the production defaults baked into
# `src/config.ts`. The committed defaults already point at sharethespire.com,
# so most users never need a local `.env`.

# Frontend URL (where the OAuth flow opens in the browser).
# SHARE_SPIRE_FRONTEND_URL=http://localhost:5173

# API base URL (where save uploads are sent).
# SHARE_SPIRE_API_URL=http://localhost:8787
